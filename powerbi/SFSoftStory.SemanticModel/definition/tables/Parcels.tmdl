	column completed
		dataType: string
		lineageTag: d37f9eee-8855-864f-91e9-ac0b2fee34bd
		summarizeBy: none
		sourceColumn: completed

		annotation SummarizationSetBy = Automatic

	column year_done
		dataType: int64
		formatString: 0
		lineageTag: 712d252a-0bd0-e375-f7df-bc6c53aa286a
