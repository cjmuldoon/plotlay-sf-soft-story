		lineageTag: 54cecd76-16c0-04f5-e84c-09d002c20525
		summarizeBy: none
		sourceColumn: status

		annotation SummarizationSetBy = Automatic

	column address
		dataType: string
		lineageTag: 614aec0d-c151-1741-1199-0c53e6cb3930
		summarizeBy: none
		sourceColumn: address

