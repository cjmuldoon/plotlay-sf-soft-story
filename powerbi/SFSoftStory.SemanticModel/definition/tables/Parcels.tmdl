table Parcels
	lineageTag: 3e9e1484-cdd8-72f4-8f21-8fcf0a0ac882

	/// Parcels on the Mandatory Soft Story Program list
	measure Parcels = COUNTROWS ( Parcels )
		formatString: #,0
		lineageTag: a491721d-a656-beb4-21a4-b632f0b201d6

	/// Listed as Work Complete, CFC Issued
	measure Complete = CALCULATE ( COUNTROWS ( Parcels ), Parcels[status] = "Complete" )
		formatString: #,0
		lineageTag: fbdbe202-eae9-d867-9246-6c792d3539d4

	measure 'Share complete' = DIVIDE ( [Complete], [Parcels] )
		formatString: 0.0%
		lineageTag: 2880acb8-4d02-7b16-19fd-34f8060a36be

	measure 'Non-compliant' = CALCULATE ( COUNTROWS ( Parcels ), Parcels[status] = "Non-compliant" )
		formatString: #,0
		lineageTag: 240c82d4-e542-f110-d0b2-2c32654e035a

	/// A point inside the parcel is in a CGS mapped liquefaction zone
	measure 'In a liquefaction zone' = CALCULATE ( COUNTROWS ( Parcels ), Parcels[liquefaction] = "yes" )
		formatString: #,0
		lineageTag: d59b7d8f-ed1a-6ac3-c8ee-11a1aa71c9a0

	column blklot
		dataType: string
		lineageTag: c7a13564-de0a-efb8-d46a-804e938b407a
		summarizeBy: none
		sourceColumn: blklot

		annotation SummarizationSetBy = Automatic

	column tier
		dataType: string
		lineageTag: f42495c1-ae93-7424-a0ea-7626c3f52061
