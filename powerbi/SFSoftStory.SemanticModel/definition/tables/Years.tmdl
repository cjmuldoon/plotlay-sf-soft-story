table Years
	lineageTag: e4a00407-f4e1-4849-a66f-076123f38494

	/// Share of the group's parcels with a completed retrofit permit by the end of the year
	measure 'Share done' = AVERAGE ( Years[share_done] )
		formatString: 0.0%
		lineageTag: 14682511-d05f-f631-1840-d4c9d8f6b0c1

	column year
		dataType: int64
		formatString: 0
		lineageTag: e98df40a-db1f-a971-feee-c5350d6c58e6
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column group
		dataType: string
		lineageTag: 4d9cb5c3-2cd1-4182-a068-28c4af893a2c
		summarizeBy: none
		sourceColumn: group

		annotation SummarizationSetBy = Automatic

	column parcels
		dataType: int64
		formatString: #,0
		lineageTag: f1c98d42-c1e4-66fe-1712-09eb6f62eb19
		summarizeBy: none
		sourceColumn: parcels

		annotation SummarizationSetBy = Automatic

	column done_by_year
		dataType: int64
		formatString: #,0
		lineageTag: de349de9-f62b-2d6c-78f5-f7d828ec397a
		summarizeBy: none
		sourceColumn: done_by_year

		annotation SummarizationSetBy = Automatic

	column share_done
		dataType: double
		formatString: 0.0%
		lineageTag: fa5ab068-a3b7-573f-1053-0c5d18561c42
		summarizeBy: none
		sourceColumn: share_done

		annotation SummarizationSetBy = Automatic

	column done_that_year
		dataType: int64
		formatString: #,0
		lineageTag: db71741d-d77c-6bf1-297e-c3b212d60e84
		summarizeBy: none
		sourceColumn: done_that_year

		annotation SummarizationSetBy = Automatic

	partition Years = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/share_done_by_year.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"year", "group", "parcels", "done_by_year", "share_done", "done_that_year"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"year", Int64.Type}, {"group", type text}, {"parcels", Int64.Type}, {"done_by_year", Int64.Type}, {"share_done", type number}, {"done_that_year", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
